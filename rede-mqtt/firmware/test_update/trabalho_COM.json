  "id": "nx_fn_state_web",
  "type": "function",
  "z": "52d3e910e6e8ef25",
  "name": "set MQTT state",
  "func": "const protocolState = flow.get(\"protocolState\") || {};\n\nprotocolState.MQTT = {\n    ...(protocolState.MQTT || {}),\n    online: true,\n    status: String(msg.payload)\n};\n\nflow.set(\"protocolState\", protocolState);\nreturn msg;",

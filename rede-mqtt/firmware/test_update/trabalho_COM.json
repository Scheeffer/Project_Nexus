 {
  "id": "nx_fn_cron_start",
  "type": "function",
  "z": "52d3e910e6e8ef25",
  "name": "Inicia cronometro",
  "func": "// Salva o momento exato em que o comando passou por aqui\nflow.set('t_start_3', Date.now());\n\n// Repassa a mensagem original sem alterações\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 470,
  "y": 620,
  "wires": [
   [
    "4f4e752f9751e484"
   ]
  ]
 },
 {
  "id": "nx_fn_cron_stop",
  "type": "function",
  "z": "52d3e910e6e8ef25",
  "name": "Para Cronômetro e Mede (ms)",
  "func": "// Recupera o tempo salvo na memória\nlet start = flow.get('t_start_3');\n\nif (start) {\n    let tempo = Date.now() - start;\n    flow.set('t_start_3', null);\n    let msgTempo = {\n        payload: tempo + \" ms\",\n        topic: \"Velocidade_Comunicacao\"\n    };\n    return [msg, msgTempo];\n}\nreturn [msg, null];",
  "outputs": 2,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 500,
  "y": 280,
  "wires": [
   [
    "nx_ui_txt_status",
    "nx_fn_state_web"
   ],
